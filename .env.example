# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL)
DB_NAME=levelproaudio
DB_USER=levelproaudio_user
DB_PASSWORD=change-me-locally
DB_HOST=db
DB_PORT=5432

# Google Cloud Storage
GCS_BUCKET_NAME=levelproaudio-media
GOOGLE_APPLICATION_CREDENTIALS=/app/gcloud-key.json

# MercadoPago
MP_ACCESS_TOKEN=your-mp-access-token
MP_PUBLIC_KEY=your-mp-public-key

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Login con Google — el Client ID es público (no un secreto)
VITE_GOOGLE_CLIENT_ID=

# Personalización de marca — se usan en index.html (título, meta tags
# de redes sociales) ANTES de que React cargue, así que no pueden leer
# la base de datos en ese momento. Cambiar esto es parte de "clonar y
# personalizar" para un cliente nuevo — el resto del branding (logo,
# color, etc.) se configura después desde /admin/settings.
VITE_SITE_NAME=LevelPro Audio
VITE_SITE_TAGLINE=Equipamiento, Academia y Servicios de Audio
VITE_SITE_DESCRIPTION=LevelPro Audio: tienda de equipamiento profesional, academia con cursos y certificaciones, servicios y sorteos exclusivos. Envíos en Chile y Argentina.
VITE_SITE_URL=https://levelproaudio.com
VITE_GA_ID=G-34L6J30WM5
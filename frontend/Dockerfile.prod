# frontend/Dockerfile.prod
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# Vite solo incluye las variables VITE_* que existan en tiempo de BUILD
# (quedan compiladas dentro del JS, no se pueden cambiar después sin
# rebuildear). Los ARG se reciben desde --build-arg en cloudbuild.yaml.
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_SITE_NAME
ARG VITE_SITE_TAGLINE
ARG VITE_SITE_DESCRIPTION
ARG VITE_SITE_URL
ARG VITE_GA_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID \
    VITE_SITE_NAME=$VITE_SITE_NAME \
    VITE_SITE_TAGLINE=$VITE_SITE_TAGLINE \
    VITE_SITE_DESCRIPTION=$VITE_SITE_DESCRIPTION \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_GA_ID=$VITE_GA_ID
RUN npm run build

FROM nginx:alpine
# nginx.conf ya tiene la URL del backend hardcodeada — sin envsubst
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]

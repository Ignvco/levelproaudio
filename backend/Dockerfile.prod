# backend/Dockerfile.prod
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ requirements/
RUN pip install --upgrade pip && \
    pip install -r requirements/production.txt

COPY . .

# collectstatic con build.py — sin DB, sin GCS, sin .env
# WhiteNoise servirá estos archivos en runtime
RUN python manage.py collectstatic --noinput \
    --settings=config.settings.build

EXPOSE 8080

# Ejecuta migraciones automáticamente al iniciar cada instancia de Cloud Run.
# El socket de Cloud SQL es inyectado por Cloud Run (--add-cloudsql-instances),
# así que la conexión a la DB está disponible en runtime.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120 --access-logfile - --error-logfile -"]
